{
  "i18n": true,
  "type": "tabs",
  "items": {
    "tunnel": {
      "type": "panel",
      "label": "tab_tunnel",
      "items": {
        "notice": {
          "type": "staticText",
          "text": "notice_linux_helper",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "interfaceName": {
          "type": "text",
          "label": "interface_name",
          "help": "interface_name_help",
          "newLine": true,
          "xs": 12,
          "sm": 4,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "listenPort": {
          "type": "number",
          "label": "listen_port",
          "min": 1,
          "max": 65535,
          "xs": 12,
          "sm": 4,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "mtu": {
          "type": "number",
          "label": "mtu",
          "help": "mtu_help",
          "min": 0,
          "max": 9000,
          "xs": 12,
          "sm": 4,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "localAddresses": {
          "type": "text",
          "label": "local_addresses",
          "help": "local_addresses_help",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "localNetworks": {
          "type": "text",
          "label": "local_networks",
          "help": "local_networks_help",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "remoteNetworks": {
          "type": "text",
          "label": "remote_networks",
          "help": "remote_networks_help",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "privateKey": {
          "type": "password",
          "label": "private_key",
          "visible": false,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "localPublicKey": {
          "type": "text",
          "label": "local_public_key",
          "help": "local_public_key_help",
          "readOnly": true,
          "copyToClipboard": true,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "generateKeypair": {
          "type": "sendTo",
          "command": "generateKeypair",
          "label": "generate_keypair",
          "icon": "auth",
          "variant": "contained",
          "useNative": true,
          "showProcess": true,
          "timeout": 10000,
          "result": {
            "keypairGenerated": "keypair_generated"
          },
          "error": {
            "generationFailed": "keypair_generation_failed",
            "notAuthorized": "keypair_not_authorized"
          },
          "confirm": {
            "condition": "!!data.privateKey",
            "title": "replace_key_title",
            "text": "replace_key_text",
            "ok": "generate",
            "cancel": "cancel",
            "type": "warning"
          },
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 8,
          "lg": 6,
          "xl": 4
        }
      }
    },
    "peer": {
      "type": "panel",
      "label": "tab_peer",
      "items": {
        "peerPublicKey": {
          "type": "text",
          "label": "peer_public_key",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "peerPresharedKey": {
          "type": "password",
          "label": "preshared_key",
          "visible": false,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "endpointHost": {
          "type": "text",
          "label": "endpoint_host",
          "help": "endpoint_host_help",
          "newLine": true,
          "xs": 12,
          "sm": 8,
          "md": 8,
          "lg": 8,
          "xl": 8
        },
        "endpointPort": {
          "type": "number",
          "label": "endpoint_port",
          "min": 1,
          "max": 65535,
          "xs": 12,
          "sm": 4,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "persistentKeepalive": {
          "type": "number",
          "label": "persistent_keepalive",
          "min": 0,
          "max": 65535,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "handshakeTimeout": {
          "type": "number",
          "label": "handshake_timeout",
          "min": 30,
          "max": 86400,
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        }
      }
    },
    "operation": {
      "type": "panel",
      "label": "tab_operation",
      "items": {
        "enableIPv4Forwarding": {
          "type": "checkbox",
          "label": "enable_ipv4_forwarding",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "enableIPv6Forwarding": {
          "type": "checkbox",
          "label": "enable_ipv6_forwarding",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "autoApply": {
          "type": "checkbox",
          "label": "auto_apply",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "pollInterval": {
          "type": "number",
          "label": "poll_interval",
          "min": 5,
          "max": 3600,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        }
      }
    }
  }
}
