{
  "name": "iobroker.wireguard-s2s",
  "version": "0.2.0",
  "description": "Safely configure and monitor one WireGuard site-to-site tunnel on an ioBroker Linux host.",
  "author": {
    "name": "Andreas Metag",
    "email": "System-9@users.noreply.github.com"
  },
  "contributors": [],
  "license": "MIT",
  "homepage": "https://github.com/System-9/ioBroker.wireguard-s2s",
  "repository": {
    "type": "git",
    "url": "https://github.com/System-9/ioBroker.wireguard-s2s.git"
  },
  "bugs": {
    "url": "https://github.com/System-9/ioBroker.wireguard-s2s/issues"
  },
  "keywords": [
    "ioBroker",
    "iobroker",
    "wireguard",
    "vpn",
    "site-to-site",
    "network"
  ],
  "engines": {
    "node": ">= 22"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "helper/",
    "scripts/",
    "io-package.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts --typescriptFormat cjs --typescriptCompileTarget node22",
    "watch": "build-adapter ts --typescriptFormat cjs --typescriptCompileTarget node22 --watch",
    "prebuild:ts": "rimraf build",
    "build:ts": "build-adapter ts --typescriptFormat cjs --typescriptCompileTarget node22",
    "watch:ts": "build-adapter ts --typescriptFormat cjs --typescriptCompileTarget node22 --watch",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:helper": "node --test test/helper.test.js",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:helper && npm run test:package",
    "check": "tsc --noEmit",
    "coverage": "nyc npm run test:ts",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script",
    "dev-server": "dev-server",
    "helper:install": "sudo ./scripts/install-helper.sh",
    "helper:uninstall": "sudo ./scripts/uninstall-helper.sh"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/iobroker": "npm:@iobroker/types@^7.2.2",
    "@types/node": "^22.18.3",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "nyc": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*.test.ts"
    ],
    "extension": [
      ".ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "reporter": [
      "text-summary",
      "html"
    ],
    "sourceMap": true,
    "instrument": true
  },
  "readmeFilename": "README.md"
}
