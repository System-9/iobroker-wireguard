{
  "name": "iobroker.wireguard-s2s",
  "version": "0.2.0",
  "description": "Manage and monitor a WireGuard site-to-site tunnel from ioBroker",
  "author": {
    "name": "Andreas Metag"
  },
  "license": "MIT",
  "homepage": "https://github.com/System-9/iobroker-wireguard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/System-9/iobroker-wireguard.git"
  },
  "bugs": {
    "url": "https://github.com/System-9/iobroker-wireguard/issues"
  },
  "keywords": [
    "iobroker",
    "wireguard",
    "vpn",
    "site-to-site",
    "network"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "helper/",
    "scripts/",
    "io-package.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js && mocha test/package.test.cjs --exit",
    "helper:install": "sudo ./scripts/install-helper.sh",
    "helper:uninstall": "sudo ./scripts/uninstall-helper.sh"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.3.2"
  },
  "devDependencies": {
    "@iobroker/testing": "^5.3.0",
    "@types/node": "^24.0.0",
    "mocha": "^11.7.6",
    "typescript": "~5.9.3"
  }
}
